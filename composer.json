{
  "name": "conkal/yoksis-rest-client",
  "description": "YÖKSİS (Yükseköğretim Bilgi Sistemi) OBS REST servisleri için PHP istemcisi",
  "type": "library",
  "keywords": [
    "yoksis",
    "yok",
    "obs",
    "rest",
    "client",
    "api",
    "universite",
    "laravel"
  ],
  "homepage": "https://github.com/cengizonkal/yoksis-rest-client",
  "license": "MIT",
  "authors": [
    {
      "name": "cengiz onkal",
      "email": "onkal.cengiz@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/cengizonkal/yoksis-rest-client/issues",
    "source": "https://github.com/cengizonkal/yoksis-rest-client"
  },
  "require": {
    "php": ">=7.2.5",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^6.5.8 || ^7.4.5",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "laravel/framework": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
    "phpunit/phpunit": "^8.5 || ^9.6"
  },
  "suggest": {
    "illuminate/support": "Laravel entegrasyonu için (service provider ve facade)"
  },
  "autoload": {
    "psr-4": {
      "Conkal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Conkal\\YOKSIS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "config": {
    "sort-packages": true,
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Conkal\\YOKSIS\\Laravel\\YoksisServiceProvider"
      ],
      "aliases": {
        "Yoksis": "Conkal\\YOKSIS\\Laravel\\Facades\\Yoksis"
      }
    }
  }
}
